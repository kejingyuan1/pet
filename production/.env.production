# ============================================================
# 宠物乐园 生产环境部署配置
# 用法：复制为 .env 后修改（docker compose 自动读取 .env）
#   cp .env.production .env
# ⚠️ 生产必改：MYSQL_ROOT_PASSWORD / JWT_SECRET / FRONTEND_PORT
# ============================================================

# ---------- 端口 ----------
# 前端访问端口（公网入口，可改 80/443 配合反向代理）
FRONTEND_PORT=8081

# 后端 API 端口（生产建议不要对外暴露，仅内网/调试用）
BACKEND_PORT=8082

# MySQL 宿主机端口（生产建议不要对外暴露！）
MYSQL_PORT=3307

# ---------- MySQL ----------
# ★ 复用外部 MySQL（宝塔面板 3306）时用这组：
# DB_HOST：容器访问宿主机 → Linux 服务器用 docker0 网关 172.17.0.1
#          （若自定义 bridge 网络或跨主机，改用宿主机 eth0 内网 IP）
#          ⚠️ 前提：MySQL 已允许该来源连接（宝塔面板 → 数据库 → root 权限 或 bind-address）
DB_HOST=172.17.0.1
DB_PORT=3306
DB_USER=root

# 生产 MySQL root 密码（用户指定：83458848de46385e）
MYSQL_ROOT_PASSWORD="83458848de46385e"

# 数据库名
MYSQL_DATABASE=pet_park

# ---------- 安全 ----------
# JWT 签名密钥（已生成随机 64 字符；如需更换：openssl rand -hex 32）
JWT_SECRET=7276cd426a1c23dbbaf8f7480a8f6a2ffe140b9391d80b76d955699dc833ada6
