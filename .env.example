# ============================================================
# 宠物乐园 Docker 部署环境变量（可选，默认值见下）
# 用法：复制为 .env 后按需修改（docker compose 自动读取 .env）
# ============================================================

# 前端访问端口（默认 8081）
FRONTEND_PORT=8081

# 后端 API 端口（默认 8082）
BACKEND_PORT=8082

# MySQL 宿主机端口（默认 3307，避免与本地 3306 冲突）
MYSQL_PORT=3307

# MySQL root 密码（默认 123456）
MYSQL_ROOT_PASSWORD=123456

# 数据库名（默认 pet_park）
MYSQL_DATABASE=pet_park

# JWT 密钥（生产环境务必改成随机长字符串！）
JWT_SECRET=please-change-this-to-a-long-random-secret-key-0123456789
